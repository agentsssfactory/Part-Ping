{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.js": { "maxDuration": 15 } },
  "redirects": [{ "source": "/simulation", "destination": "/simulation/", "permanent": false }],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/|simulation/|assets/).*)", "destination": "/index.html" }
  ]
}
