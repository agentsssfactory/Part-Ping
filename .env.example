# --- required on Vercel (Settings → Environment Variables) ---
# Any long random text
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@partping.com
# Local default below. Use a strong password on Vercel.
ADMIN_PASSWORD=admin123
# DATABASE_URL is added automatically when you connect a Neon Postgres database in Vercel.
# Leave it empty locally: the app uses an embedded Postgres in ./data/pglite.
DATABASE_URL=

# --- optional ---
BUSINESS_NAME=PartPing
PORT=4000
# Local: demo customer (demo@partping.com / demo123) is created unless SEED_DEMO=0.
# Vercel: no demo customer unless SEED_DEMO=1.
SEED_DEMO=1
